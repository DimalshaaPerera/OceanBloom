# Copy this file to a new file named exactly ".env" (no .example) and fill it in.
# NEVER share your .env file or include it in your submission - it can hold a secret key.
# If no email provider is set up the game still works; welcome emails are just
# printed in the terminal instead of being sent.

PORT=3000

# ---- Which email service to use ----
#   mailpit - local test inbox, nothing is sent to real people (recommended for development)
#   brevo   - real emails through the Brevo web API (fill in the Brevo section below)
EMAIL_PROVIDER=mailpit

MAIL_FROM_ADDRESS=no-reply@oceanbloom.local
MAIL_FROM_NAME=OceanBloom

# ---- Mailpit (local test inbox) ----
# Start it in a second terminal with:  npm.cmd run mailpit
# Then open http://localhost:8025 to read every email the game sends.
MAILPIT_URL=http://localhost:8025

# ---- Brevo web API (free plan: 300 emails per day) - only when EMAIL_PROVIDER=brevo ----
# 1. Create a free account at https://www.brevo.com
# 2. Add your own email address as a sender (Senders, Domains & Dedicated IPs -> Senders)
#    and click the verification link Brevo emails you.
# 3. Create an API key (top-right menu -> SMTP & API -> API Keys -> Generate a new API key).
# 4. Paste the key below, and put your verified sender address in MAIL_FROM_ADDRESS above.
BREVO_API_KEY=

# ---- Database (MySQL / MariaDB, e.g. XAMPP) ----
# Create the tables first: phpMyAdmin -> SQL tab -> paste database/oceanbloom.sql -> Go.
# XAMPP's default user is root with an empty password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=oceanbloom
